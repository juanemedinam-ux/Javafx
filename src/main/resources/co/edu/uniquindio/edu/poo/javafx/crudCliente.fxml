<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="566.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.edu.poo.javafx.viewController.ClienteViewController">

    <children>
        <VBox spacing="15.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <Label text="GESTIÓN DE CLIENTES"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Información del cliente"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <HBox spacing="10.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Cédula"/>
                    <TextField fx:id="txtCedula" promptText="Ingrese la cédula"/>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Nombre"/>
                    <TextField fx:id="txtNombre" promptText="Ingrese el nombre"/>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Apellido"/>
                    <TextField fx:id="txtApellido" promptText="Ingrese el apellido"/>
                </VBox>
            </HBox>

            <HBox spacing="10.0">
                <Button fx:id="btbAgregarCliente"
                        text="Agregar"
                        onAction="#onAgregarCliente"/>

                <Button fx:id="btnActualizarCliente"
                        text="Actualizar"
                        onAction="#onActualizarCliente"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        onAction="#onEliminar"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar"
                        onAction="#onLimpiar"/>
            </HBox>

            <Label text="Listado de clientes"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <TableView fx:id="tblListCliente" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tbcCedula" text="Cédula" prefWidth="180.0"/>
                    <TableColumn fx:id="tbcNombre" text="Nombre" prefWidth="180.0"/>
                    <TableColumn fx:id="tbcApellido" text="Apellido" prefWidth="180.0"/>
                </columns>
            </TableView>

        </VBox>
    </children>
</AnchorPane>
